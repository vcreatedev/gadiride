# Sanity project (shared by both datasets)
NEXT_PUBLIC_SANITY_PROJECT_ID=imd3p4ax
# "production" only for gadiride.com (Vercel Production, main branch).
# "development" locally and for dev.gadiride.com (Vercel Preview, dev branch).
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: instant updates after publishing (see README > Instant updates).
SANITY_REVALIDATE_SECRET=

# Public site URL, used for social share images.
NEXT_PUBLIC_SITE_URL=https://gadiride.com

